# Скопируйте этот файл в .env и заполните ключи. Файл .env в git не попадает.

# Обязательно для анализа и скриптов. Бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Нужен один из двух ключей карт, иначе поиск компаний не запустится.

# Google Places: телефоны приходят сразу, есть бесплатный месячный объём, дальше оплата за запросы.
GOOGLE_PLACES_API_KEY=

# 2ГИС: лучше покрывает Казахстан, но телефоны подключаются за отдельную плату через отдел продаж.
DGIS_API_KEY=

# Необязательные настройки
# MAP_PROVIDER=google
# LLM_MODEL=openai/gpt-oss-120b
# LEAD_FINDER_PORT=5050
